<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="Remonode Canary">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Deep link landing screen (see ProductActivity). No autoVerify on the https filter, on purpose: we
             don't own example.com, and an unverified link going to the browser is the failure the Deep link
             check template demonstrates when Open URL's Target app is left empty. -->
        <activity
            android:name=".ProductActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="example.com" android:pathPrefix="/product" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="remonode-canary" android:host="product" />
            </intent-filter>
        </activity>
        <!-- A deliberately broken screen for the AI screen check template: remonode-canary://broken -->
        <activity
            android:name=".BrokenActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="remonode-canary" android:host="broken" />
            </intent-filter>
        </activity>
        <!-- The "Freeze (ANR)" button. Not exported: only the app's own button sends to it. -->
        <receiver
            android:name=".FreezeReceiver"
            android:exported="false" />
    </application>

</manifest>
